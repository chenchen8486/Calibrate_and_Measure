# Visual Studio 缓存与构建产物
.vs/
x64/
*.user

# 本机第三方库路径配置（含绝对路径，各机器复制 opencv_onnx_paths.props.example 自行维护）
opencv_onnx_paths.props

# 本地临时文件（背景模型缓存、流程图中间稿等）
temp/

