# Visual Studio 缓存与构建产物
.vs/
x64/
*.user
*.obj

# 本机第三方库路径配置（含绝对路径，各机器复制 opencv_onnx_paths.props.example 自行维护）
opencv_onnx_paths.props

# 本地临时文件（QA 图、矫正预览、临时工具等）
temp/*
# 预生成背景模型缓存随库分发（功能 3 Init 缓存优先加载；现场场景变更后须重学替换）
!temp/background_model.bmp

# assets 只保留目录结构与示例图，数据与模型权重不入库（按需随包分发）
assets/checkerboard/*
!assets/checkerboard/.gitkeep

# 随包分发给集成本机的第三方库（约 850MB，不随 git 仓库分发）
lib/
lib.rar

assets/calibration/*
!assets/calibration/.gitkeep

assets/weights/*
!assets/weights/.gitkeep

assets/test_data/input/*
!assets/test_data/input/.gitkeep
assets/test_data/input-bak/

assets/test_data/calibration/*
!assets/test_data/calibration/.gitkeep

assets/test_data/output/*
!assets/test_data/output/.gitkeep
